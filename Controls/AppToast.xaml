<?xml version="1.0" encoding="utf-8" ?>

<Grid
    x:Class="HisabKitab.Controls.AppToast"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    HorizontalOptions="Fill"
    VerticalOptions="End"
    Margin="12,0,12,98"
    HeightRequest="82"
    IsVisible="False"
    IsEnabled="False"
    InputTransparent="True"
    ZIndex="200">

    <Grid
        x:Name="ToastTouchArea"
        HorizontalOptions="Fill"
        VerticalOptions="Fill">

        <Grid.GestureRecognizers>
            <PanGestureRecognizer PanUpdated="ToastPanUpdated" />
        </Grid.GestureRecognizers>

        <Border
            x:Name="ToastCard"
            HorizontalOptions="Fill"
            VerticalOptions="Center"
            HeightRequest="68"
            Padding="14,10"
            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1A2016}"
            Stroke="{AppThemeBinding Light=#E3E7DC, Dark=#30382B}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 18"
            TranslationY="55"
            TranslationX="0"
            Opacity="0"
            Scale="0.98">

            <Border.Shadow>
                <Shadow
                    Brush="#66000000"
                    Offset="0,5"
                    Radius="12"
                    Opacity="0.28" />
            </Border.Shadow>

            <Grid ColumnDefinitions="8,*,34" ColumnSpacing="10">

                <BoxView
                    x:Name="AccentBar"
                    Grid.Column="0"
                    WidthRequest="5"
                    CornerRadius="3"
                    VerticalOptions="Fill"
                    HorizontalOptions="Center" />

                <VerticalStackLayout
                    Grid.Column="1"
                    VerticalOptions="Center"
                    Spacing="2">

                    <Label
                        x:Name="TypeLabel"
                        FontSize="10"
                        FontAttributes="Bold"
                        Text="INFO"
                        TextColor="{StaticResource PrimaryColor}" />

                    <Label
                        x:Name="MessageLabel"
                        FontSize="13"
                        FontAttributes="Bold"
                        LineBreakMode="TailTruncation"
                        MaxLines="2"
                        TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" />

                </VerticalStackLayout>

                <Label
                    Grid.Column="2"
                    Text="×"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Light={StaticResource LightSecondaryText}, Dark={StaticResource DarkSecondaryText}}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />

            </Grid>
        </Border>
    </Grid>
</Grid>
