<?xml version="1.0" encoding="utf-8" ?>
<Grid x:Class="HisabKitab.Controls.LoadingOverlay" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" HorizontalOptions="Fill" VerticalOptions="Fill" SafeAreaEdges="None" IsVisible="False" InputTransparent="False" ZIndex="999999">
    <Grid HorizontalOptions="Fill" VerticalOptions="Fill" BackgroundColor="#66000000">
        <Border WidthRequest="170" HeightRequest="145" HorizontalOptions="Center" VerticalOptions="Center" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1A2016}" Stroke="{AppThemeBinding Light=#E3E7DC, Dark=#30382B}" StrokeThickness="1" StrokeShape="RoundRectangle 22" Padding="20">
            <Border.Shadow>
                <Shadow Brush="#66000000" Offset="0,6" Radius="16" Opacity="0.25" />
            </Border.Shadow>
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                <ActivityIndicator x:Name="Spinner" WidthRequest="42" HeightRequest="42" Color="#718238" IsRunning="False" />
                <Label x:Name="MessageLabel" Text="Processing..." FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light=#20251C, Dark=#F4F6EF}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</Grid>