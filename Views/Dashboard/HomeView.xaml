<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="HisabKitab.Views.Dashboard.HomeView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{AppThemeBinding
        Light=#F5F7F0,
        Dark=#10140E}"
    Loaded="HomeView_Loaded">

    <Grid>

        <!-- SKELETON -->
        <Grid
            x:Name="SkeletonContainer"
            IsVisible="True">

            <ScrollView>

                <VerticalStackLayout
                    Padding="20,22,20,115"
                    Spacing="14">

                    <Border
                        Style="{StaticResource SkeletonBox}"
                        WidthRequest="110"
                        HeightRequest="14" />

                    <Border
                        Style="{StaticResource SkeletonBox}"
                        WidthRequest="165"
                        HeightRequest="27" />

                    <Border
                        Style="{StaticResource SkeletonBox}"
                        WidthRequest="220"
                        HeightRequest="13" />

                    <Border
                        Style="{StaticResource SkeletonBox}"
                        HeightRequest="88"
                        Margin="0,8,0,8" />

                    <Border
                        Style="{StaticResource SkeletonBox}"
                        WidthRequest="160"
                        HeightRequest="18" />

                    <Grid
                        ColumnDefinitions="*,*"
                        RowDefinitions="115,115"
                        ColumnSpacing="12"
                        RowSpacing="12">

                        <Border
                            Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource SkeletonBox}" />

                        <Border
                            Grid.Row="0"
                            Grid.Column="1"
                            Style="{StaticResource SkeletonBox}" />

                        <Border
                            Grid.Row="1"
                            Grid.Column="0"
                            Style="{StaticResource SkeletonBox}" />

                        <Border
                            Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource SkeletonBox}" />

                    </Grid>

                    <Border
                        Style="{StaticResource SkeletonBox}"
                        WidthRequest="145"
                        HeightRequest="18"
                        Margin="0,10,0,0" />

                    <Grid
                        ColumnDefinitions="*,*"
                        RowDefinitions="90,90"
                        ColumnSpacing="12"
                        RowSpacing="12">

                        <Border
                            Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource SkeletonBox}" />

                        <Border
                            Grid.Row="0"
                            Grid.Column="1"
                            Style="{StaticResource SkeletonBox}" />

                        <Border
                            Grid.Row="1"
                            Grid.Column="0"
                            Style="{StaticResource SkeletonBox}" />

                        <Border
                            Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource SkeletonBox}" />

                    </Grid>

                    <Border
                        Style="{StaticResource SkeletonBox}"
                        HeightRequest="180"
                        Margin="0,10,0,0" />

                    <Border
                        Style="{StaticResource SkeletonBox}"
                        HeightRequest="150" />

                </VerticalStackLayout>

            </ScrollView>

        </Grid>


        <Grid
            x:Name="DashboardContainer"
            IsVisible="False">

            <RefreshView
                    x:Name="DashboardRefreshView"
                    RefreshColor="#718238"
                    IsRefreshing="False"
                    Refreshing="DashboardRefreshView_Refreshing"
                    VerticalOptions="Fill"
                    HorizontalOptions="Fill">
                
                <ScrollView>

                    <VerticalStackLayout
            Padding="20,22,20,30"
            Spacing="0">

                        <Label
                x:Name="GreetingLabel"
                Text="Good Evening 👋"
                FontSize="14"
                TextColor="{AppThemeBinding
                    Light=#737A6B,
                    Dark=#A8AF9E}" />

                        <Label
                x:Name="UserNameLabel"
                Text="User"
                FontSize="27"
                FontAttributes="Bold"
                TextColor="{AppThemeBinding
                    Light=#20251C,
                    Dark=#F4F6EF}"
                Margin="0,3,0,0" />

                        <Label
                Text="Manage your business with ease"
                FontSize="13"
                TextColor="{AppThemeBinding
                    Light=#737A6B,
                    Dark=#A8AF9E}"
                Margin="0,3,0,22" />

                        <Border
                x:Name="CompanyCard"
                BackgroundColor="#718238"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 20"
                Padding="18"
                Margin="0,0,0,24">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="CompanyCardTapped" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="54,*,25">

                                <Border
                        HeightRequest="50"
                        WidthRequest="50"
                        BackgroundColor="White"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 16">

                                    <Label
                            x:Name="CompanyInitialLabel"
                            Text="H"
                            FontSize="23"
                            FontAttributes="Bold"
                            TextColor="#718238"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />

                                </Border>

                                <VerticalStackLayout
                        Grid.Column="1"
                        VerticalOptions="Center"
                        Spacing="3">

                                    <Label
                            x:Name="CompanyNameLabel"
                            Text="My Business"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="White" />

                                    <Label
                            x:Name="FinancialYearLabel"
                            Text="Financial Year"
                            FontSize="12"
                            TextColor="#EEF2E3" />

                                </VerticalStackLayout>

                                <Label
                        Grid.Column="2"
                        Text="›"
                        FontSize="28"
                        TextColor="White"
                        VerticalOptions="Center"
                        HorizontalOptions="End" />

                            </Grid>

                        </Border>

                        <Label
                Text="Today's Overview"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="{AppThemeBinding
                    Light=#20251C,
                    Dark=#F4F6EF}"
                Margin="0,0,0,14" />

                        <Grid
                ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto"
                ColumnSpacing="12"
                RowSpacing="12">

                            <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="{AppThemeBinding
                        Light=#FFFFFF,
                        Dark=#1A2016}"
                    Stroke="{AppThemeBinding
                        Light=#E3E7DC,
                        Dark=#30382B}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="16">

                                <VerticalStackLayout Spacing="7">

                                    <Label
                            Text="SALES"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding
                                Light=#737A6B,
                                Dark=#A8AF9E}" />

                                    <Label
                            x:Name="SalesAmount"
                            Text="₹ 0"
                            FontSize="22"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding
                                Light=#20251C,
                                Dark=#F4F6EF}" />

                                    <Label
                            Text="Today"
                            FontSize="11"
                            TextColor="#4F9D5F" />

                                </VerticalStackLayout>

                            </Border>

                            <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    BackgroundColor="{AppThemeBinding
                        Light=#FFFFFF,
                        Dark=#1A2016}"
                    Stroke="{AppThemeBinding
                        Light=#E3E7DC,
                        Dark=#30382B}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="16">

                                <VerticalStackLayout Spacing="7">

                                    <Label
                            Text="COLLECTED"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding
                                Light=#737A6B,
                                Dark=#A8AF9E}" />

                                    <Label
                            x:Name="CollectionAmount"
                            Text="₹ 0"
                            FontSize="22"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding
                                Light=#20251C,
                                Dark=#F4F6EF}" />

                                    <Label
                            Text="Today"
                            FontSize="11"
                            TextColor="#4F9D5F" />

                                </VerticalStackLayout>

                            </Border>

                            <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    BackgroundColor="{AppThemeBinding
                        Light=#FFFFFF,
                        Dark=#1A2016}"
                    Stroke="{AppThemeBinding
                        Light=#E3E7DC,
                        Dark=#30382B}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="16">

                                <VerticalStackLayout Spacing="7">

                                    <Label
                            Text="Receivable"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding
                                Light=#737A6B,
                                Dark=#A8AF9E}" />

                                    <Label
                            x:Name="ReceivableAmount"
                            Text="₹ 0"
                            FontSize="22"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding
                                Light=#20251C,
                                Dark=#F4F6EF}" />

                                    <Label
                            Text="Pending"
                            FontSize="11"
                            TextColor="#D9943B" />

                                </VerticalStackLayout>

                            </Border>

                            <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    BackgroundColor="{AppThemeBinding
                        Light=#FFFFFF,
                        Dark=#1A2016}"
                    Stroke="{AppThemeBinding
                        Light=#E3E7DC,
                        Dark=#30382B}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="16">

                                <VerticalStackLayout Spacing="7">

                                    <Label     
                            Text="INVOICE"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding
                                Light=#737A6B,
                                Dark=#A8AF9E}" />

                                    <Label
                            x:Name="InvoiceCount"
                            Text="0"
                            FontSize="22"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding
                                Light=#20251C,
                                Dark=#F4F6EF}" />

                                    <Label
                            Text="This month"
                            FontSize="11"
                            TextColor="{AppThemeBinding
                                Light=#737A6B,
                                Dark=#A8AF9E}" />

                                </VerticalStackLayout>

                            </Border>

                        </Grid>

                        <!-- ================= MONTHLY PERFORMANCE ================= -->

                        <Grid
    ColumnDefinitions="*,Auto"
    Margin="0,28,0,14">

                            <Label
        Text="Monthly Performance"
        FontSize="18"
        FontAttributes="Bold"
        TextColor="{AppThemeBinding
            Light=#20251C,
            Dark=#F4F6EF}" />

                            <Label
        Grid.Column="1"
        Text="This Year"
        FontSize="12"
        TextColor="#718238"
        VerticalOptions="Center" />

                        </Grid>


                        <Border
    BackgroundColor="{AppThemeBinding
        Light=#FFFFFF,
        Dark=#1A2016}"
    Stroke="{AppThemeBinding
        Light=#E3E7DC,
        Dark=#30382B}"
    StrokeThickness="1"
    StrokeShape="RoundRectangle 18"
    Padding="18">

                            <Border.Shadow>
                                <Shadow
            Brush="#44000000"
            Offset="0,4"
            Radius="10"
            Opacity="0.18" />
                            </Border.Shadow>

                            <VerticalStackLayout Spacing="14">

                                <Grid ColumnDefinitions="*,Auto">

                                    <VerticalStackLayout>

                                        <Label
                    Text="Total Sales"
                    FontSize="12"
                    TextColor="{AppThemeBinding
                        Light=#737A6B,
                        Dark=#A8AF9E}" />

                                        <Label
                    x:Name="MonthlySalesAmount"
                    Text="₹ 0"
                    FontSize="24"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding
                        Light=#20251C,
                        Dark=#F4F6EF}" />

                                    </VerticalStackLayout>

                                    <Label
                x:Name="MonthlySalesGrowthLabel"
                Grid.Column="1"
                Text="0%"
                FontSize="12"
                FontAttributes="Bold"
                TextColor="#4F9D5F"
                VerticalOptions="Center" />

                                </Grid>


                                <!-- Simple chart -->

                                <Grid
            HeightRequest="100"
            ColumnDefinitions="*,*,*,*,*,*,*"
            ColumnSpacing="7"
            VerticalOptions="End">

                                    <BoxView
                Grid.Column="0"
                HeightRequest="35"
                VerticalOptions="End"
                BackgroundColor="#718238"
                CornerRadius="6" />

                                    <BoxView
                Grid.Column="1"
                HeightRequest="58"
                VerticalOptions="End"
                BackgroundColor="#718238"
                CornerRadius="6" />

                                    <BoxView
                Grid.Column="2"
                HeightRequest="45"
                VerticalOptions="End"
                BackgroundColor="#718238"
                CornerRadius="6" />

                                    <BoxView
                Grid.Column="3"
                HeightRequest="72"
                VerticalOptions="End"
                BackgroundColor="#718238"
                CornerRadius="6" />

                                    <BoxView
                Grid.Column="4"
                HeightRequest="60"
                VerticalOptions="End"
                BackgroundColor="#718238"
                CornerRadius="6" />

                                    <BoxView
                Grid.Column="5"
                HeightRequest="82"
                VerticalOptions="End"
                BackgroundColor="#718238"
                CornerRadius="6" />

                                    <BoxView
                Grid.Column="6"
                HeightRequest="92"
                VerticalOptions="End"
                BackgroundColor="#718238"
                CornerRadius="6" />

                                </Grid>

                                <Grid
            ColumnDefinitions="*,*,*,*,*,*,*">

                                    <Label
                Text="Jan"
                FontSize="9"
                TextColor="#8A9181"
                HorizontalOptions="Center" />

                                    <Label
                Grid.Column="1"
                Text="Feb"
                FontSize="9"
                TextColor="#8A9181"
                HorizontalOptions="Center" />

                                    <Label
                Grid.Column="2"
                Text="Mar"
                FontSize="9"
                TextColor="#8A9181"
                HorizontalOptions="Center" />

                                    <Label
                Grid.Column="3"
                Text="Apr"
                FontSize="9"
                TextColor="#8A9181"
                HorizontalOptions="Center" />

                                    <Label
                Grid.Column="4"
                Text="May"
                FontSize="9"
                TextColor="#8A9181"
                HorizontalOptions="Center" />

                                    <Label
                Grid.Column="5"
                Text="Jun"
                FontSize="9"
                TextColor="#8A9181"
                HorizontalOptions="Center" />

                                    <Label
                Grid.Column="6"
                Text="Jul"
                FontSize="9"
                TextColor="#8A9181"
                HorizontalOptions="Center" />

                                </Grid>

                            </VerticalStackLayout>

                        </Border>


                        <!-- ================= OUTSTANDING ================= -->

                        <Label
    Text="Outstanding"
    FontSize="18"
    FontAttributes="Bold"
    TextColor="{AppThemeBinding
        Light=#20251C,
        Dark=#F4F6EF}"
    Margin="0,28,0,14" />


                        <Grid
    ColumnDefinitions="*,*"
    ColumnSpacing="12">

                            <Border
        BackgroundColor="{AppThemeBinding
            Light=#FFFFFF,
            Dark=#1A2016}"
        Stroke="{AppThemeBinding
            Light=#E3E7DC,
            Dark=#30382B}"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 18"
        Padding="16">

                                <VerticalStackLayout Spacing="7">

                                    <Label
                Text="CUSTOMERS"
                FontSize="10"
                FontAttributes="Bold"
                TextColor="#737A6B" />

                                    <Label
                x:Name="CustomerCountLabel"
                Text="0"
                FontSize="24"
                FontAttributes="Bold"
                TextColor="{AppThemeBinding
                    Light=#20251C,
                    Dark=#F4F6EF}" />

                                    <Label
                Text="Need payment"
                FontSize="11"
                TextColor="#D9943B" />

                                </VerticalStackLayout>

                            </Border>


                            <Border
        Grid.Column="1"
        BackgroundColor="{AppThemeBinding
            Light=#FFFFFF,
            Dark=#1A2016}"
        Stroke="{AppThemeBinding
            Light=#E3E7DC,
            Dark=#30382B}"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 18"
        Padding="16">

                                <VerticalStackLayout Spacing="7">

                                    <Label
                Text="SUPPLIERS"
                FontSize="10"
                FontAttributes="Bold"
                TextColor="#737A6B" />

                                    <Label
                x:Name="SupplierCountLabel"
                Text="0"
                FontSize="24"
                FontAttributes="Bold"
                TextColor="{AppThemeBinding
                    Light=#20251C,
                    Dark=#F4F6EF}" />

                                    <Label
                Text="To be paid"
                FontSize="11"
                TextColor="#D9943B" />

                                </VerticalStackLayout>

                            </Border>

                        </Grid>


                        <!-- ================= LOW STOCK ================= -->

                        <Grid
    ColumnDefinitions="*,Auto"
    Margin="0,28,0,14">

                            <Label
        Text="Low Stock"
        FontSize="18"
        FontAttributes="Bold"
        TextColor="{AppThemeBinding
            Light=#20251C,
            Dark=#F4F6EF}" />

                            <Label
        Grid.Column="1"
        Text="View All"
        FontSize="12"
        TextColor="#718238"
        VerticalOptions="Center" />

                        </Grid>


                        <Border
    BackgroundColor="{AppThemeBinding
        Light=#FFFFFF,
        Dark=#1A2016}"
    Stroke="{AppThemeBinding
        Light=#E3E7DC,
        Dark=#30382B}"
    StrokeThickness="1"
    StrokeShape="RoundRectangle 18"
    Padding="0">

                            <VerticalStackLayout>

                                <Grid
            Padding="16"
            ColumnDefinitions="46,*,Auto">

                                    <Border
                HeightRequest="40"
                WidthRequest="40"
                BackgroundColor="#FBF1E7"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 12">

                                        <Image
                    Source="product.svg"
                    HeightRequest="20"
                    WidthRequest="20" />

                                    </Border>

                                    <VerticalStackLayout
                Grid.Column="1"
                VerticalOptions="Center">

                                        <Label
                    x:Name="LowStockProduct1NameLabel"
                    Text="Premium Rice"
                    FontSize="14"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding
                        Light=#20251C,
                        Dark=#F4F6EF}" />

                                        <Label
                    x:Name="LowStockProduct1QtyTextLabel"
                    Text="Only 8 units left"
                    FontSize="11"
                    TextColor="#D9943B" />

                                    </VerticalStackLayout>

                                    <Label
                x:Name="LowStockProduct1QtyLabel"
                Grid.Column="2"
                Text="8"
                FontSize="15"
                FontAttributes="Bold"
                TextColor="#D9943B"
                VerticalOptions="Center" />

                                </Grid>


                                <BoxView
            HeightRequest="1"
            BackgroundColor="{AppThemeBinding
                Light=#E3E7DC,
                Dark=#30382B}" />


                                <Grid
            Padding="16"
            ColumnDefinitions="46,*,Auto">

                                    <Border
                HeightRequest="40"
                WidthRequest="40"
                BackgroundColor="#FBF1E7"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 12">

                                        <Image
                    Source="product.svg"
                    HeightRequest="20"
                    WidthRequest="20" />

                                    </Border>

                                    <VerticalStackLayout
                Grid.Column="1"
                VerticalOptions="Center">

                                        <Label
                    x:Name="LowStockProduct2NameLabel"
                    Text="Wheat Flour"
                    FontSize="14"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding
                        Light=#20251C,
                        Dark=#F4F6EF}" />

                                        <Label
                    x:Name="LowStockProduct2QtyTextLabel"
                    Text="Only 5 units left"
                    FontSize="11"
                    TextColor="#D9943B" />

                                    </VerticalStackLayout>

                                    <Label
                x:Name="LowStockProduct2QtyLabel"
                Grid.Column="2"
                Text="5"
                FontSize="15"
                FontAttributes="Bold"
                TextColor="#D9943B"
                VerticalOptions="Center" />

                                </Grid>

                            </VerticalStackLayout>

                        </Border>


                        <!-- EXTRA BOTTOM SPACE FOR GLASS NAVBAR -->

                        <BoxView
    HeightRequest="115"
    Opacity="0" />

                    </VerticalStackLayout>

                </ScrollView>
            </RefreshView>
        </Grid>
        
    </Grid>

</ContentView>