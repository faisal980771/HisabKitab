<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="HisabKitab.Views.SalesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{StaticResource PageBackgroundColor}"
    Title="Sales">

    <VerticalStackLayout
        Padding="20"
        Spacing="15">

        <Label
            Text="Sales"
            Style="{StaticResource TitleLabel}" />

        <Label
            Text="Manage your sales invoices"
            Style="{StaticResource SubtitleLabel}" />

        <Button
            Text="+ New Invoice"
            HeightRequest="52"
            CornerRadius="14"
            BackgroundColor="{StaticResource PrimaryColor}"
            TextColor="White"
            FontAttributes="Bold" />

        <Border
            Style="{StaticResource CardStyle}"
            Margin="0,5,0,0">

            <VerticalStackLayout>

                <Label
                    Text="No invoices yet"
                    FontSize="16"
                    FontAttributes="Bold" />

                <Label
                    Text="Your recent sales invoices will appear here."
                    Style="{StaticResource SubtitleLabel}"
                    Margin="0,5,0,0" />

            </VerticalStackLayout>

        </Border>

    </VerticalStackLayout>

</ContentPage>