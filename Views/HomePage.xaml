<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="HisabKitab.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{AppThemeBinding
        Light=#F5F7F0,
        Dark=#10140E}"
    Shell.NavBarIsVisible="False">

    <ScrollView>

        <VerticalStackLayout
            Padding="20,22,20,30"
            Spacing="0">

            <!-- ================= HEADER ================= -->

            <Grid
                ColumnDefinitions="*,52"
                Margin="0,0,0,22">

                <VerticalStackLayout
                    Spacing="3">

                    <Label
                        Text="Good Evening 👋"
                        FontSize="14"
                        TextColor="{AppThemeBinding
                            Light=#737A6B,
                            Dark=#A8AF9E}" />

                    <Label
                        Text="HisabKitab"
                        FontSize="27"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding
                            Light=#20251C,
                            Dark=#F4F6EF}" />

                    <Label
                        Text="Manage your business with ease"
                        FontSize="13"
                        TextColor="{AppThemeBinding
                            Light=#737A6B,
                            Dark=#A8AF9E}" />

                </VerticalStackLayout>


                <!-- Notification -->

                <Border
                    Grid.Column="1"
                    HeightRequest="48"
                    WidthRequest="48"
                    HorizontalOptions="End"
                    BackgroundColor="{AppThemeBinding
                        Light=#FFFFFF,
                        Dark=#1A2016}"
                    Stroke="{AppThemeBinding
                        Light=#E3E7DC,
                        Dark=#30382B}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16">

                    <Border.Shadow>
                        <Shadow
                            Brush="#44000000"
                            Offset="0,3"
                            Radius="9"
                            Opacity="0.18" />
                    </Border.Shadow>

                    <Image
                        Source="bell.svg"
                        HeightRequest="21"
                        WidthRequest="21" />

                </Border>

            </Grid>


            <!-- ================= BUSINESS ================= -->

            <Border
                BackgroundColor="#718238"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 20"
                Padding="18"
                Margin="0,0,0,24">

                <Border.Shadow>
                    <Shadow
                        Brush="#55000000"
                        Offset="0,5"
                        Radius="12"
                        Opacity="0.24" />
                </Border.Shadow>

                <Grid
                    ColumnDefinitions="54,*,25"
                    ColumnSpacing="12">

                    <Border
                        HeightRequest="50"
                        WidthRequest="50"
                        BackgroundColor="#FFFFFF"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 16">

                        <Label
                            Text="H"
                            FontSize="23"
                            FontAttributes="Bold"
                            TextColor="#718238"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />

                    </Border>


                    <VerticalStackLayout
                        Grid.Column="1"
                        VerticalOptions="Center"
                        Spacing="3">

                        <Label
                            Text="My Business"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="White" />

                        <Label
                            Text="Financial Year 2026-27"
                            FontSize="12"
                            TextColor="#EEF2E3" />

                    </VerticalStackLayout>


                    <Label
                        Grid.Column="2"
                        Text="›"
                        FontSize="28"
                        TextColor="White"
                        VerticalOptions="Center"
                        HorizontalOptions="End" />

                </Grid>

            </Border>


            <!-- ================= OVERVIEW ================= -->

            <Label
                Text="Today's Overview"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="{AppThemeBinding
                    Light=#20251C,
                    Dark=#F4F6EF}"
                Margin="0,0,0,14" />


            <Grid
                ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto"
                ColumnSpacing="12"
                RowSpacing="12">


                <!-- SALES -->

                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="{AppThemeBinding
                        Light=#FFFFFF,
                        Dark=#1A2016}"
                    Stroke="{AppThemeBinding
                        Light=#E3E7DC,
                        Dark=#30382B}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="16">

                    <Border.Shadow>
                        <Shadow
                            Brush="#44000000"
                            Offset="0,4"
                            Radius="10"
                            Opacity="0.20" />
                    </Border.Shadow>

                    <VerticalStackLayout
                        Spacing="8">

                        <Grid
                            ColumnDefinitions="*,38">

                            <Label
                                Text="SALES"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding
                                    Light=#737A6B,
                                    Dark=#A8AF9E}" />

                            <Border
                                Grid.Column="1"
                                HeightRequest="34"
                                WidthRequest="34"
                                BackgroundColor="#EEF2E3"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 11">

                                <Image
                                    Source="sales.svg"
                                    HeightRequest="17"
                                    WidthRequest="17" />

                            </Border>

                        </Grid>

                        <Label
                            Text="₹ 12,500"
                            FontSize="22"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding
                                Light=#20251C,
                                Dark=#F4F6EF}" />

                        <Label
                            Text="Today"
                            FontSize="11"
                            TextColor="#4F9D5F" />

                    </VerticalStackLayout>

                </Border>


                <!-- COLLECTION -->

                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    BackgroundColor="{AppThemeBinding
                        Light=#FFFFFF,
                        Dark=#1A2016}"
                    Stroke="{AppThemeBinding
                        Light=#E3E7DC,
                        Dark=#30382B}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="16">

                    <Border.Shadow>
                        <Shadow
                            Brush="#44000000"
                            Offset="0,4"
                            Radius="10"
                            Opacity="0.20" />
                    </Border.Shadow>

                    <VerticalStackLayout
                        Spacing="8">

                        <Grid
                            ColumnDefinitions="*,38">

                            <Label
                                Text="COLLECTION"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding
                                    Light=#737A6B,
                                    Dark=#A8AF9E}" />

                            <Border
                                Grid.Column="1"
                                HeightRequest="34"
                                WidthRequest="34"
                                BackgroundColor="#EDF5ED"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 11">

                                <Label
                                    Text="₹"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="#4F9D5F"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />

                            </Border>

                        </Grid>

                        <Label
                            Text="₹ 8,250"
                            FontSize="22"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding
                                Light=#20251C,
                                Dark=#F4F6EF}" />

                        <Label
                            Text="Today"
                            FontSize="11"
                            TextColor="#4F9D5F" />

                    </VerticalStackLayout>

                </Border>


                <!-- RECEIVABLE -->

                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    BackgroundColor="{AppThemeBinding
                        Light=#FFFFFF,
                        Dark=#1A2016}"
                    Stroke="{AppThemeBinding
                        Light=#E3E7DC,
                        Dark=#30382B}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="16">

                    <Border.Shadow>
                        <Shadow
                            Brush="#44000000"
                            Offset="0,4"
                            Radius="10"
                            Opacity="0.20" />
                    </Border.Shadow>

                    <VerticalStackLayout
                        Spacing="8">

                        <Grid
                            ColumnDefinitions="*,38">

                            <Label
                                Text="RECEIVABLE"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding
                                    Light=#737A6B,
                                    Dark=#A8AF9E}" />

                            <Border
                                Grid.Column="1"
                                HeightRequest="34"
                                WidthRequest="34"
                                BackgroundColor="#FBF1E7"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 11">

                                <Label
                                    Text="₹"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="#D9943B"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />

                            </Border>

                        </Grid>

                        <Label
                            Text="₹ 48,500"
                            FontSize="22"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding
                                Light=#20251C,
                                Dark=#F4F6EF}" />

                        <Label
                            Text="Pending"
                            FontSize="11"
                            TextColor="#D9943B" />

                    </VerticalStackLayout>

                </Border>


                <!-- INVOICES -->

                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    BackgroundColor="{AppThemeBinding
                        Light=#FFFFFF,
                        Dark=#1A2016}"
                    Stroke="{AppThemeBinding
                        Light=#E3E7DC,
                        Dark=#30382B}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="16">

                    <Border.Shadow>
                        <Shadow
                            Brush="#44000000"
                            Offset="0,4"
                            Radius="10"
                            Opacity="0.20" />
                    </Border.Shadow>

                    <VerticalStackLayout
                        Spacing="8">

                        <Grid
                            ColumnDefinitions="*,38">

                            <Label
                                Text="INVOICES"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding
                                    Light=#737A6B,
                                    Dark=#A8AF9E}" />

                            <Border
                                Grid.Column="1"
                                HeightRequest="34"
                                WidthRequest="34"
                                BackgroundColor="#EEF2E3"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 11">

                                <Label
                                    Text="#"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="#718238"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />

                            </Border>

                        </Grid>

                        <Label
                            Text="24"
                            FontSize="22"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding
                                Light=#20251C,
                                Dark=#F4F6EF}" />

                        <Label
                            Text="This month"
                            FontSize="11"
                            TextColor="{AppThemeBinding
                                Light=#737A6B,
                                Dark=#A8AF9E}" />

                    </VerticalStackLayout>

                </Border>

            </Grid>


            <!-- ================= QUICK ACTIONS ================= -->

            <Grid
                ColumnDefinitions="*,Auto"
                Margin="0,26,0,14">

                <Label
                    Text="Quick Actions"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding
                        Light=#20251C,
                        Dark=#F4F6EF}" />

                <Label
                    Grid.Column="1"
                    Text="View All"
                    FontSize="12"
                    TextColor="#718238"
                    VerticalOptions="Center" />

            </Grid>


            <Grid
                ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto"
                ColumnSpacing="12"
                RowSpacing="12">


                <!-- INVOICE -->

                <Border
                    BackgroundColor="{AppThemeBinding
                        Light=#FFFFFF,
                        Dark=#1A2016}"
                    Stroke="{AppThemeBinding
                        Light=#E3E7DC,
                        Dark=#30382B}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="16">

                    <Border.Shadow>
                        <Shadow
                            Brush="#44000000"
                            Offset="0,4"
                            Radius="10"
                            Opacity="0.18" />
                    </Border.Shadow>

                    <Grid
                        ColumnDefinitions="48,*"
                        ColumnSpacing="12">

                        <Border
                            HeightRequest="44"
                            WidthRequest="44"
                            BackgroundColor="#EEF2E3"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 14">

                            <Image
                                Source="invoice.svg"
                                HeightRequest="22"
                                WidthRequest="22" />

                        </Border>

                        <VerticalStackLayout
                            Grid.Column="1"
                            VerticalOptions="Center">

                            <Label
                                Text="Invoice"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding
                                    Light=#20251C,
                                    Dark=#F4F6EF}" />

                            <Label
                                Text="Create new"
                                FontSize="11"
                                TextColor="{AppThemeBinding
                                    Light=#737A6B,
                                    Dark=#A8AF9E}" />

                        </VerticalStackLayout>

                    </Grid>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="InvoiceTapped" />
                    </Border.GestureRecognizers>

                </Border>


                <!-- CUSTOMER -->

                <Border
                    Grid.Column="1"
                    BackgroundColor="{AppThemeBinding
                        Light=#FFFFFF,
                        Dark=#1A2016}"
                    Stroke="{AppThemeBinding
                        Light=#E3E7DC,
                        Dark=#30382B}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="16">

                    <Border.Shadow>
                        <Shadow
                            Brush="#44000000"
                            Offset="0,4"
                            Radius="10"
                            Opacity="0.18" />
                    </Border.Shadow>

                    <Grid
                        ColumnDefinitions="48,*"
                        ColumnSpacing="12">

                        <Border
                            HeightRequest="44"
                            WidthRequest="44"
                            BackgroundColor="#EDF5ED"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 14">

                            <Image
                                Source="customer.svg"
                                HeightRequest="22"
                                WidthRequest="22" />

                        </Border>

                        <VerticalStackLayout
                            Grid.Column="1"
                            VerticalOptions="Center">

                            <Label
                                Text="Customer"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding
                                    Light=#20251C,
                                    Dark=#F4F6EF}" />

                            <Label
                                Text="Add customer"
                                FontSize="11"
                                TextColor="{AppThemeBinding
                                    Light=#737A6B,
                                    Dark=#A8AF9E}" />

                        </VerticalStackLayout>

                    </Grid>

                </Border>


                <!-- PRODUCT -->

                <Border
                    Grid.Row="1"
                    BackgroundColor="{AppThemeBinding
                        Light=#FFFFFF,
                        Dark=#1A2016}"
                    Stroke="{AppThemeBinding
                        Light=#E3E7DC,
                        Dark=#30382B}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="16">

                    <Border.Shadow>
                        <Shadow
                            Brush="#44000000"
                            Offset="0,4"
                            Radius="10"
                            Opacity="0.18" />
                    </Border.Shadow>

                    <Grid
                        ColumnDefinitions="48,*"
                        ColumnSpacing="12">

                        <Border
                            HeightRequest="44"
                            WidthRequest="44"
                            BackgroundColor="#FBF1E7"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 14">

                            <Image
                                Source="product.svg"
                                HeightRequest="22"
                                WidthRequest="22" />

                        </Border>

                        <VerticalStackLayout
                            Grid.Column="1"
                            VerticalOptions="Center">

                            <Label
                                Text="Product"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding
                                    Light=#20251C,
                                    Dark=#F4F6EF}" />

                            <Label
                                Text="Add product"
                                FontSize="11"
                                TextColor="{AppThemeBinding
                                    Light=#737A6B,
                                    Dark=#A8AF9E}" />

                        </VerticalStackLayout>

                    </Grid>

                </Border>


                <!-- PAYMENT -->

                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    BackgroundColor="{AppThemeBinding
                        Light=#FFFFFF,
                        Dark=#1A2016}"
                    Stroke="{AppThemeBinding
                        Light=#E3E7DC,
                        Dark=#30382B}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="16">

                    <Border.Shadow>
                        <Shadow
                            Brush="#44000000"
                            Offset="0,4"
                            Radius="10"
                            Opacity="0.18" />
                    </Border.Shadow>

                    <Grid
                        ColumnDefinitions="48,*"
                        ColumnSpacing="12">

                        <Border
                            HeightRequest="44"
                            WidthRequest="44"
                            BackgroundColor="#F0EDF8"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 14">

                            <Image
                                Source="payment.svg"
                                HeightRequest="22"
                                WidthRequest="22" />

                        </Border>

                        <VerticalStackLayout
                            Grid.Column="1"
                            VerticalOptions="Center">

                            <Label
                                Text="Payment"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding
                                    Light=#20251C,
                                    Dark=#F4F6EF}" />

                            <Label
                                Text="Record payment"
                                FontSize="11"
                                TextColor="{AppThemeBinding
                                    Light=#737A6B,
                                    Dark=#A8AF9E}" />

                        </VerticalStackLayout>

                    </Grid>

                </Border>

            </Grid>


            <!-- ================= RECENT INVOICES ================= -->

            <Grid
                ColumnDefinitions="*,Auto"
                Margin="0,26,0,14">

                <Label
                    Text="Recent Invoices"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding
                        Light=#20251C,
                        Dark=#F4F6EF}" />

                <Label
                    Grid.Column="1"
                    Text="View All"
                    FontSize="12"
                    TextColor="#718238"
                    VerticalOptions="Center" />

            </Grid>


            <Border
                BackgroundColor="{AppThemeBinding
                    Light=#FFFFFF,
                    Dark=#1A2016}"
                Stroke="{AppThemeBinding
                    Light=#E3E7DC,
                    Dark=#30382B}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 18"
                Padding="0">

                <Border.Shadow>
                    <Shadow
                        Brush="#44000000"
                        Offset="0,4"
                        Radius="10"
                        Opacity="0.18" />
                </Border.Shadow>

                <VerticalStackLayout>

                    <!-- Invoice 1 -->

                    <Grid
                        Padding="16"
                        ColumnDefinitions="48,*,Auto">

                        <Border
                            HeightRequest="40"
                            WidthRequest="40"
                            BackgroundColor="#EEF2E3"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 12">

                            <Label
                                Text="IN"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="#718238"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />

                        </Border>

                        <VerticalStackLayout
                            Grid.Column="1"
                            VerticalOptions="Center">

                            <Label
                                Text="INV-0025"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding
                                    Light=#20251C,
                                    Dark=#F4F6EF}" />

                            <Label
                                Text="Sharma Traders"
                                FontSize="11"
                                TextColor="{AppThemeBinding
                                    Light=#737A6B,
                                    Dark=#A8AF9E}" />

                        </VerticalStackLayout>

                        <VerticalStackLayout
                            Grid.Column="2"
                            HorizontalOptions="End"
                            VerticalOptions="Center">

                            <Label
                                Text="₹ 12,500"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding
                                    Light=#20251C,
                                    Dark=#F4F6EF}"
                                HorizontalTextAlignment="End" />

                            <Label
                                Text="PAID"
                                FontSize="10"
                                TextColor="#4F9D5F"
                                HorizontalTextAlignment="End" />

                        </VerticalStackLayout>

                    </Grid>


                    <BoxView
                        HeightRequest="1"
                        BackgroundColor="{AppThemeBinding
                            Light=#E3E7DC,
                            Dark=#30382B}" />


                    <!-- Invoice 2 -->

                    <Grid
                        Padding="16"
                        ColumnDefinitions="48,*,Auto">

                        <Border
                            HeightRequest="40"
                            WidthRequest="40"
                            BackgroundColor="#EEF2E3"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 12">

                            <Label
                                Text="IN"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="#718238"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />

                        </Border>

                        <VerticalStackLayout
                            Grid.Column="1"
                            VerticalOptions="Center">

                            <Label
                                Text="INV-0024"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding
                                    Light=#20251C,
                                    Dark=#F4F6EF}" />

                            <Label
                                Text="ABC Stores"
                                FontSize="11"
                                TextColor="{AppThemeBinding
                                    Light=#737A6B,
                                    Dark=#A8AF9E}" />

                        </VerticalStackLayout>

                        <VerticalStackLayout
                            Grid.Column="2"
                            HorizontalOptions="End"
                            VerticalOptions="Center">

                            <Label
                                Text="₹ 8,200"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding
                                    Light=#20251C,
                                    Dark=#F4F6EF}"
                                HorizontalTextAlignment="End" />

                            <Label
                                Text="PENDING"
                                FontSize="10"
                                TextColor="#D9943B"
                                HorizontalTextAlignment="End" />

                        </VerticalStackLayout>

                    </Grid>

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>